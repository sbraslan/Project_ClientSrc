<Project>
  <!--
    Granny x64 runtime/import library.
    Uses the native x64 library installed with Granny Viewer.
    Proprietary Granny binaries are not committed to the repository.
  -->
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <GrannyX64LibDir>C:\Program Files (x86)\Granny Viewer\lib\win64</GrannyX64LibDir>
    <GrannyX64Library>granny2_x64.lib</GrannyX64Library>
    <GrannyX64Dll>$(GrannyX64LibDir)\granny2_x64.dll</GrannyX64Dll>

    <GrannyX64Available Condition="Exists('$(GrannyX64LibDir)\$(GrannyX64Library)')">true</GrannyX64Available>
    <GrannyX64Available Condition="'$(GrannyX64Available)'==''">false</GrannyX64Available>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(Platform)'=='x64' and '$(ProjectName)'=='UserInterface' and '$(GrannyX64Available)'=='true'">
    <Link>
      <AdditionalLibraryDirectories>$(GrannyX64LibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>$(GrannyX64Library);%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!--
    Reproducible native x64 open-source dependency stack.
    Install dependencies with the repository vcpkg manifest using the
    x64-windows-static triplet and the repo-local vcpkg_installed directory.
  -->
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <Metin2VcpkgTriplet>x64-windows-static</Metin2VcpkgTriplet>
    <Metin2VcpkgRoot>$(MSBuildThisFileDirectory)..\vcpkg_installed\$(Metin2VcpkgTriplet)</Metin2VcpkgRoot>
    <Metin2VcpkgReady Condition="Exists('$(Metin2VcpkgRoot)\include\cryptopp\cryptlib.h') and Exists('$(Metin2VcpkgRoot)\include\jpeglib.h') and Exists('$(Metin2VcpkgRoot)\include\lzo\lzo1x.h')">true</Metin2VcpkgReady>
    <Metin2VcpkgReady Condition="'$(Metin2VcpkgReady)'==''">false</Metin2VcpkgReady>
    <Metin2VcpkgLibDir Condition="'$(Configuration)'=='Debug'">$(Metin2VcpkgRoot)\debug\lib</Metin2VcpkgLibDir>
    <Metin2VcpkgLibDir Condition="'$(Configuration)'!='Debug'">$(Metin2VcpkgRoot)\lib</Metin2VcpkgLibDir>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(Platform)'=='x64' and '$(Metin2VcpkgReady)'=='true'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(Metin2VcpkgRoot)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>METIN2_X64_MODERN_DEPS=1;_SILENCE_STDEXT_ARR_ITERS_DEPRECATION_WARNING=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Platform)'=='x64' and '$(ProjectName)'=='UserInterface' and '$(Metin2VcpkgReady)'=='true'">
    <Link>
      <AdditionalLibraryDirectories>$(Metin2VcpkgLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>cryptopp.lib;jpeg.lib;lzo2.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!--
    x64 migration quality gate.
    Do not suppress migration warnings: the x64 build must remain warning-free.
  -->
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>